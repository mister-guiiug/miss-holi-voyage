node_modules/
dist/
.DS_Store
*.log

# Variables d'environnement / secrets — JAMAIS commités.
.env
.env.*
!.env.example

# Rapports de couverture (npm run test:coverage)
coverage/
.lighthouseci/

# Copies complètes du dépôt créées par les agents lancés en « isolation:
# worktree » : masquées par `.git/info/exclude` (local), donc invisibles à
# `git status` ici mais analysées par Prettier et ESLint partout ailleurs.
.claude/worktrees/

# Artefacts Playwright — rapports, traces, vidéos, captures d'échec.
playwright-report/
test-results/

supabase/.temp/

# MCP voyage (venv + magasin local)
mcp/.venv/
mcp/**/__pycache__/
mcp/**/*.py[cod]
mcp/data/*.json
!mcp/data/.gitkeep
