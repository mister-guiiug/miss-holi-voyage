{
  "name": "miss-holi-voyage",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "description": "Preparez un voyage en famille : profil du foyer, questions IA, dates et vols, style hub ou roadtrip, shortlist d excursions - decisions partagees.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget && pwa-doctor --strict",
    "build:analyze": "node scripts/with-env.mjs ANALYZE=1 -- npm run build",
    "preview": "vite preview --base /miss-holi-voyage/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check": "tsc -b",
    "type-check:7": "pwa-typecheck-7",
    "doctor": "pwa-doctor",
    "icons": "pwa-icons --source public/favicon.svg --out public/icons --maskable --bg 6,16,24",
    "prepare": "husky || true",
    "screenshots": "pwa-screenshots --wide-path reglages"
  },
  "bundleBudget": {
    "_pourquoi": "REPOSÉ le 31/10/2026 après le catalogue Destinations (continents / pays / lieux, auto-complétion enrichie) dans le chunk principal — pas de lazy : pwa-doctor --strict refuse les morceaux différés sans prefetch + BottomNav navigate, et un catalogue offline ne justifie pas ce couple. Relevés locaux du build : main 599 kB brut, préchargé 200,2 kB gzip, total 301,4 kB gzip → +10 % arrondi (formule de pwa-bundle-budget). MESURER EN CI au prochain run et réajuster si l’écart plateforme est réel. Antérieur 20/09 : marge trop serrée sur le squelette ; PostHog reste hors préchargé (loader après consentement).",
    "totalGzipKb": 332,
    "preloadGzipKb": 221,
    "mainChunkKb": 659
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@mister-guiiug/dev-pwa-config": "^6.28.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.64.0",
    "posthog-js": "^1.442.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@rolldown/plugin-babel": {
      "@babel/plugin-transform-runtime": "^7.29.0"
    }
  }
}
